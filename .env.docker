# =============================================================================
#  .env.docker — Environment variables for Docker Compose
# =============================================================================
#  Copy this file and fill in real secrets for production.
#  These values are ONLY for local development.
# =============================================================================

# ── PostgreSQL ──
POSTGRES_USER=elango08
POSTGRES_PASSWORD=elango08
POSTGRES_DB=flight_booking_db

# ── Backend Database URL ──
# Host is "postgres" (Docker service name, NOT localhost)
DATABASE_URL=postgresql+asyncpg://elango08:elango08@postgres:5432/flight_booking_db

# ── Redis ──
# Host is "redis" (Docker service name, NOT localhost)
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT / Auth ──
SECRET_KEY=flight-booking-jwt-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── SMTP / Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=skybookofficial0@gmail.com
SMTP_PASS=ygof sitx uzzx jmyh

# ── Frontend (Vite) ──
VITE_API_URL=http://localhost:8000
